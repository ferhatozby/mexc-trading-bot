# Bu dosyayı ".env" olarak kopyalayıp gerçek değerleri gir.
# API anahtarında SADECE "trade" (işlem) izni olsun, "withdraw" (çekme) izni KAPALI olmalı.
MEXC_API_KEY=buraya_api_key
MEXC_API_SECRET=buraya_api_secret
FLASK_SECRET=rastgele-uzun-bir-anahtar-buraya
PANEL_PASSWORD=paneli-acan-sifre-buraya
PORT=8000
